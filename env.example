# Copy this to .env and adjust for your node/server
# cp env.example .env
#
# .env is gitignored — safe for machine-specific settings

# Container paths
MIMIC_SIF=/path/to/vllm_26.01.sif
MIMIC_OVERLAY=/path/to/vllm_overlay.img
MIMIC_HF_CACHE=$HOME/.cache/huggingface
MIMIC_PROJECT=$(pwd)

# GPU config
CUDA_VISIBLE_DEVICES=0
VLLM_TP=1

# Overlay mount mode: "ro" for read-only, "" for read-write
OVERLAY_MOUNT=ro
